{
  "connectors": {
    "jira": {
      "url": "https://YOUR_RUNLAYER_HOST/YOUR_JIRA_CONNECTOR_PATH",
      "headers": { "Authorization": "Bearer ${RUNLAYER_AGENT_TOKEN}" },
      "tools": ["getJiraIssue", "searchJiraIssuesUsingJql"],
      "rules": [
        { "tool": "searchJiraIssuesUsingJql", "arg": "jql", "jql_project": "FXA", "exclude_labels": ["HackerOne", "security"] },
        { "arg": "cloudId", "set": "mozilla-hub.atlassian.net" },
        { "arg": "fields", "include": ["security", "labels"], "deny": ["issuelinks", "parent", "subtasks"],
          "default": ["summary", "description", "status", "issuetype", "priority", "labels", "components",
                      "assignee", "reporter", "created", "updated", "resolution", "project"] }
      ],
      "deny_result": ["\"security\"\\s*:\\s*\\{", "(?i)\"labels\"\\s*:\\s*\\[[^\\]]*\"(HackerOne|security)\""]
    },
    "github": {
      "url": "https://YOUR_RUNLAYER_HOST/YOUR_GITHUB_CONNECTOR_PATH",
      "headers": { "Authorization": "Bearer ${RUNLAYER_AGENT_TOKEN}" },
      "tools": ["get_pull_request", "get_pull_request_reviews", "get_pull_request_comments",
                "get_pull_request_status", "get_issue", "list_issues", "get_file_contents",
                "list_commits", "get_commit", "get_job_logs"],
      "rules": [
        { "arg": "owner", "equals": "mozilla" },
        { "arg": "repo", "equals": "fxa" }
      ]
    },
    "slack": {
      "url": "https://YOUR_RUNLAYER_HOST/YOUR_SLACK_CONNECTOR_PATH",
      "headers": { "Authorization": "Bearer ${RUNLAYER_AGENT_TOKEN}" },
      "tools": ["slack_read_thread", "slack_read_channel"],
      "rules": [
        { "arg": "channel_id", "one_of": ["YOUR_CHANNEL_ID"] }
      ]
    },
    "bugzilla": {
      "url": "https://YOUR_RUNLAYER_HOST/YOUR_BUGZILLA_CONNECTOR_PATH",
      "headers": { "Authorization": "Bearer ${RUNLAYER_AGENT_TOKEN}" },
      "tools": ["get_bugzilla_bug"]
    },
    "figma": {
      "url": "https://YOUR_RUNLAYER_HOST/YOUR_FIGMA_CONNECTOR_PATH",
      "headers": { "Authorization": "Bearer ${RUNLAYER_AGENT_TOKEN}" },
      "tools": ["get_design_context", "get_metadata", "get_screenshot", "get_variable_defs",
                "search_design_system"],
      "rules": [
        { "tool": "get_screenshot", "arg": "enableBase64Response", "set": true }
      ]
    },
    "sentry": {
      "url": "https://mcp.sentry.dev/mcp",
      "headers": { "Authorization": "Sentry-Bearer ${SENTRY_ACCESS_TOKEN}" },
      "tools": ["find_projects", "search_issues", "search_errors", "get_sentry_resource"],
      "rules": [
        {"arg": "organizationSlug", "set": "mozilla"},
        {"arg": "regionUrl", "set": "https://us.sentry.io"},
        {"tool": "get_sentry_resource", "arg": "url", "drop": true},
        {"tool": "get_sentry_resource", "arg": "resourceType", "one_of": ["issue", "event", "trace"]}
      ],
      "redact": [
        ["(?i)(\"(?:(?:client-)?ja[34][\\w-]*|[\\w-]*ohfp|h2fp|cookie|set-cookie|authorization)\"\\s*:\\s*)\"[^\"]*\"", "\\1\"[redacted]\""],
        ["(?i)(\"(?:cookie|set-cookie|authorization)\"\\s*,\\s*)\"[^\"]*\"", "\\1\"[redacted]\""],
        ["(?im)^(\\s*(?:set-cookie|cookie|authorization)):[ \\t]*\\S.*$", "\\1: [redacted]"],
        ["(?<![A-Za-z0-9._%+-])[A-Za-z0-9._%+-]{1,64}@[A-Za-z0-9-]+(?:\\.[A-Za-z0-9-]+)*\\.[A-Za-z]{2,}", "[email]"],
        ["\\beyJ[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+", "[jwt]"],
        ["(?i)\\b(Bearer|Basic|Hawk)\\s+\\S{8,}", "\\1 [redacted]"],
        ["(?i)([?&;](?:email|login_hint|[\\w]*token|code|state|password|key\\w*)=)[^&\\s\\\"'#)\\]]+", "\\1[redacted]"],
        ["(?<![\\w+])\\+\\d{8,15}\\b", "[phone]"],
        ["(?<![\\d.])(?:(?:25[0-5]|2[0-4]\\d|1?\\d?\\d)\\.){3}(?:25[0-5]|2[0-4]\\d|1?\\d?\\d)(?![\\d.])", "[ip]"],
        ["(?i)(?<![\\w:])(?:[0-9a-f]{1,4}:){7}[0-9a-f]{1,4}(?![\\w:])", "[ip]"],
        ["(?i)(?<![\\w:])(?:[0-9a-f]{1,4}:){1,6}:(?:[0-9a-f]{1,4}(?::[0-9a-f]{1,4}){0,5})?(?![\\w:])", "[ip]"],
        ["(?i)\\b[0-9a-f]{64}\\b", "[token]"]
      ],
      "redact_keys": "(?i)email|ip|ip_address|(?:client-)?ja[34][\\w-]*|[\\w-]*ohfp|h2fp|cookie|set-cookie|authorization"
    },
    "argocd": {
      "url": "https://YOUR_ARGOCD_MCP_HOST/mcp",
      "oauth_issuer": "https://YOUR_ARGOCD_MCP_HOST",
      "oauth_callback_port": 9382,
      "headers": { "Authorization": "Bearer ${RUNLAYER_OAUTH_TOKEN}" },
      "tools": ["search_operations", "execute_operation"],
      "tool_note": "Apps: YOUR_APP_NAMES. Recipes, all GET under /api/v1/applications/<app>: version, health, sync and last sync: the app itself (status.summary.images, status.health, status.sync, status.operationState, status.conditions); why it is unhealthy: the status.resources entries whose health is not Healthy, then <app>/events; one resource: <app>/resource with query_params {\"namespace\":...,\"resourceName\":...,\"kind\":...,\"group\":...,\"version\":...}; pod logs: <app>/pods/<pod>/logs with {\"container\":...,\"tailLines\":\"200\"}. Never <app>/resource-tree or <app>/managed-resources: they are over the size limit.",
      "prune_keys": "managedFields|notified\\.notifications\\.argoproj\\.io|kubectl\\.kubernetes\\.io/last-applied-configuration|normalizedLiveState|predictedLiveState|syncResult|resourceVersion|uid|creationTimestamp|generation",
      "max_result_bytes": 122880,
      "max_result_hint": "Ask for less: the app itself, its /events, one resource with /resource?namespace=...&resourceName=...&kind=...&group=...&version=..., or pod logs with tailLines. Not /resource-tree or /managed-resources of a whole app.",
      "rules": [
        { "tool": "execute_operation", "arg": "method", "set": "GET" },
        { "tool": "execute_operation", "arg": "body", "drop": true },
        { "tool": "execute_operation", "arg": "path", "match": "/api/v1/applications/fxa-[a-z0-9-]+(/[A-Za-z0-9_-][A-Za-z0-9._-]*)*" },
        { "tool": "execute_operation", "arg": "query_params", "optional": true, "match": "(?is)(?!.*refresh[\"']?\\s*:(?!\\s*[\"']?false[\"'\\s,}])).*" }
      ],
      "redact": [["(?i)(\"(?:(?:client-)?ja[34][\\w-]*|[\\w-]*ohfp|h2fp|cookie|set-cookie|authorization)\"\\s*:\\s*)\"[^\"]*\"", "\\1\"[redacted]\""], ["(?i)(\"(?:cookie|set-cookie|authorization)\"\\s*,\\s*)\"[^\"]*\"", "\\1\"[redacted]\""], ["(?im)^(\\s*(?:set-cookie|cookie|authorization)):[ \\t]*\\S.*$", "\\1: [redacted]"], ["(?<![A-Za-z0-9._%+-])[A-Za-z0-9._%+-]{1,64}@[A-Za-z0-9-]+(?:\\.[A-Za-z0-9-]+)*\\.[A-Za-z]{2,}", "[email]"], ["\\beyJ[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+", "[jwt]"], ["(?i)\\b(Bearer|Basic|Hawk)\\s+\\S{8,}", "\\1 [redacted]"], ["(?i)([?&;](?:email|login_hint|[\\w]*token|code|state|password|key\\w*)=)[^&\\s\\\"'#)\\]]+", "\\1[redacted]"], ["(?<![\\w+])\\+\\d{8,15}\\b", "[phone]"], ["(?<![\\d.])(?:(?:25[0-5]|2[0-4]\\d|1?\\d?\\d)\\.){3}(?:25[0-5]|2[0-4]\\d|1?\\d?\\d)(?![\\d.])", "[ip]"], ["(?i)(?<![\\w:])(?:[0-9a-f]{1,4}:){7}[0-9a-f]{1,4}(?![\\w:])", "[ip]"], ["(?i)(?<![\\w:])(?:[0-9a-f]{1,4}:){1,6}:(?:[0-9a-f]{1,4}(?::[0-9a-f]{1,4}){0,5})?(?![\\w:])", "[ip]"], ["(?i)\\b[0-9a-f]{64}\\b", "[token]"]],
      "redact_keys": "(?i)email|ip|ip_address|(?:client-)?ja[34][\\w-]*|[\\w-]*ohfp|h2fp|cookie|set-cookie|authorization"
    },
    "grafana": {
      "url": "http://127.0.0.1:8000/mcp",
      "headers": { "X-Grafana-Service-Account-Token": "${GRAFANA_TOKEN}" },
      "tools": ["search_dashboards", "get_dashboard_summary", "get_dashboard_by_uid", "get_dashboard_panel_queries", "get_dashboard_property", "list_datasources", "get_datasource", "query_prometheus", "query_prometheus_histogram", "list_prometheus_metric_names", "list_prometheus_metric_metadata", "list_prometheus_label_names", "list_prometheus_label_values", "alerting_rules_read", "get_annotations", "generate_deeplink"]
    }
  }
}
