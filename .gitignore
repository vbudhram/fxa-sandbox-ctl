# Secrets — never commit
.env
.env.*
!.env.example

# Per-agent state (SSH keys, metadata, VM logs, Firefox profiles)
logs/

# Local Claude Code settings
.claude/

# macOS
.DS_Store

# Python bytecode
__pycache__/
*.pyc

# Editor swap / scratch
*.swp
*.tmp

# Real pipeline output: snapshots, transcripts, API results. Never commit these.
dashboard/*.json
*.jsonl

# Talk decks and exported chats sit in the tree but are not part of the tool.
talk/
Claude outputs/
*.pptx

# Operator-only data: Jira emails.
reporters.tsv
