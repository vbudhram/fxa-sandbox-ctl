#!/usr/bin/env -S python3 -I
"""fxa-mem: search the team memory on this runner, and propose notes for it (standard library only)."""
import fnmatch, glob, json, os, re, sqlite3, subprocess, sys, time

MEM = os.environ.get("FXA_MEM_DIR", "/home/agent/.fxa-memory")
USE = os.environ.get("FXA_MEM_USE", "/workspace/.fxa-memory-use.jsonl")
STOP = set("a an and are as at be by for from in is it of on or that the this to with".split())
RATINGS = ("helped", "wrong", "stale")
OUT = os.environ.get("FXA_MEM_OUT", "/workspace/.fxa-memory.json")
KINDS = ("convention", "trap", "command", "decision", "owner-area")  # same list as _MEMORY_KINDS in lib/memory.sh
TEAM_KINDS = ("convention", "trap", "command", "decision", "owner-area", "system")  # same list as _MEMORY_TEAM_KINDS
TEAM_CITE_RE = r"[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+:[A-Za-z0-9_./@+-]+:[0-9]{1,6}"
CITES = ("cite", "cite2", "cite3")
ID_RE = r"mem-[0-9a-f]{8}"
FLAGS = ("repo", "kind", "text", "cite", "anchor", "why", "path", "terms", "op", "id")
NEED = ("kind", "text", "why", "terms")  # with repo, cite and anchor, checked apart for --team
SEEN = os.environ.get("FXA_MEM_SEEN", "/workspace/.fxa-mem-hook-seen")
HOOK_ERR_RE = r"error|failed|err!|exception|traceback|cannot|not found|refused|denied|fatal"
HOOK_MIN_SCORE = 7.5  # negated BM25; 24 error texts and 10 unrelated ones put the cut between 6.7 and 8.4


def load():
    """Parse every entry of repos/*/*.md, then teams/*/*.md (repo "team"), in topic file order. A block with no meta line is skipped."""
    out = []
    files = sorted(glob.glob(os.path.join(MEM, "repos", "*", "*.md"))) + sorted(glob.glob(os.path.join(MEM, "teams", "*", "*.md")))
    for f in files:
        if os.path.basename(f) == "INDEX.md":
            continue
        repo, topic = os.path.basename(os.path.dirname(f)), os.path.basename(f)
        if os.path.basename(os.path.dirname(os.path.dirname(f))) == "teams":
            repo = "team"
        with open(f, encoding="utf-8", errors="replace") as fh:
            blocks = re.split(r"(?m)^(?=## mem-[0-9a-f]{8}$)", fh.read())
        for b in blocks:
            head, _, rest = b.partition("\n")
            meta_line, _, body = rest.partition("\n")
            if not re.fullmatch(r"## mem-[0-9a-f]{8}", head) or not (meta_line.startswith("<!--") and meta_line.rstrip().endswith("-->")):
                continue
            meta = {}
            for kv in meta_line.strip()[4:-3].split(" | "):
                k, _, v = kv.strip().partition(": ")
                meta[k.strip()] = v.strip()
            text, _, why = body.partition("\nWhy: ")
            out.append(dict(id=head[3:], repo=repo, topic=topic, meta=meta, text=text.strip(), why=why.strip()))
    return out


def log(**rec):
    rec["at"] = int(time.time())
    try:
        with open(USE, "a") as fh:
            fh.write(json.dumps(rec) + "\n")
    except OSError:
        pass


def hit(e):
    snip = " ".join(e["text"].split())[:100]
    return "%s [%s] %s -> %s/%s (confirmed %s)" % (e["id"], e["meta"].get("kind", ""), snip, e["repo"], e["topic"], e["meta"].get("confirmed", ""))


def old(e):
    """True when the entry was not confirmed in the last 90 days: it ranks after newer ones."""
    return e["meta"].get("confirmed", "") < time.strftime("%Y-%m-%d", time.gmtime(time.time() - 90 * 86400))


def have_memory():
    if os.path.isdir(os.path.join(MEM, "repos")) or os.path.isdir(os.path.join(MEM, "teams")):
        return True
    print("no team memory on this runner")
    return False


def rank(entries, toks):
    """(id, score) of the entries that match any token, best first. The score is the negated BM25: higher is better."""
    if not toks or not entries:
        return []
    db = sqlite3.connect(":memory:")
    db.execute("create virtual table m using fts5(id unindexed, text, why, path, cite, anchor, terms, tokenize='porter unicode61')")
    db.executemany("insert into m values (?,?,?,?,?,?,?)", [
        (e["id"], e["text"], e["why"], e["meta"].get("path", ""), " ".join(e["meta"].get(k, "") for k in CITES),
         " ".join(e["meta"].get(k, "") for k in ("anchor", "anchor2", "anchor3")), e["meta"].get("terms", "")) for e in entries])
    q = " OR ".join('"%s"' % t for t in toks)
    return db.execute("select id, -bm25(m, 0, 1.0, 0.3, 2.0, 1.0, 2.0, 2.0) s from m where m match ? order by s desc", (q,)).fetchall()


def search(words):
    if not have_memory():
        return 0
    entries = load()
    toks = []
    for t in re.findall(r"[a-z0-9]+", " ".join(words).lower()):
        if t not in STOP and t not in toks:
            toks.append(t)
    by_id = {e["id"]: e for e in entries}
    ids = sorted((i for i, _ in rank(entries, toks)), key=lambda i: old(by_id[i]))[:5]
    for i in ids:
        print(hit(by_id[i]))
    if not ids:
        print("no match")
    log(cmd="search", q=" ".join(words), ids=ids)
    return 0


def show(args):
    if len(args) != 1:
        return usage()
    e = next((e for e in load() if e["id"] == args[0]), None)
    if not e:
        print("unknown id %s" % args[0])
        return 1
    print("## " + e["id"])
    for k in ("kind", "path", "cite", "anchor", "cite2", "anchor2", "cite3", "anchor3", "confirmed"):
        if k in ("kind", "path", "cite", "anchor", "confirmed") or k in e["meta"]:
            print("%s: %s" % (k, e["meta"].get(k, "")))
    print(e["text"] + "\n\nWhy: " + e["why"])
    log(cmd="show", id=e["id"])
    return 0


def git(*args):
    """The output of a git command in the current directory, or "" when it fails."""
    try:
        return subprocess.run(("git",) + args, capture_output=True, text=True, timeout=5).stdout.strip()
    except (OSError, subprocess.SubprocessError):
        return ""


def repo_from_git():
    """The owner__repo folder of the origin remote of the current directory, or None."""
    url = git("remote", "get-url", "origin")
    m = re.search(r"([^/:]+)/([^/:]+?)(?:\.git)?/?$", url)
    return "%s__%s" % m.groups() if m else None


def rel_path(p):
    """The path from the top of the git tree: an absolute path inside it loses that prefix, and ./ goes."""
    top = os.path.isabs(p) and git("rev-parse", "--show-toplevel")
    if top:
        r = os.path.relpath(os.path.realpath(p), os.path.realpath(top))
        p = p if r.startswith("..") else r
    while p.startswith("./"):
        p = p[2:]
    return p


def on_path(p, glob_):
    """A folder matches the glob of the files in it, so packages/x matches packages/x/**."""
    return fnmatch.fnmatchcase(p, glob_) or fnmatch.fnmatchcase(p + "/", glob_)


def trap_hits(repo, path):
    """The traps on a path, for the owner__repo folder name (None: the origin repo of the current directory)."""
    if repo is None:
        repo = repo_from_git()
    named = repo  # team traps filter on it even when the repo has no folder here
    path = rel_path(path)
    if repo is None or not os.path.isdir(os.path.join(MEM, "repos", repo)):
        repo = None  # all repos
    traps_ = [e for e in load() if e["meta"].get("kind") == "trap"]
    hits = [e for e in traps_ if e["repo"] != "team" and (repo is None or e["repo"] == repo)
            and e["meta"].get("path") and on_path(path, e["meta"]["path"])]
    # A team trap after the repo's own: one of its cites names the repo; an empty path matches only a named repo.
    hits += [e for e in traps_ if e["repo"] == "team"
             and (named is None or any(e["meta"].get(k, "").split(":")[0].replace("/", "__") == named for k in CITES))
             and (on_path(path, e["meta"]["path"]) if e["meta"].get("path") else named is not None)]
    # Within the repo's traps and within the team's, an entry older than 90 days comes last.
    n_repo = sum(e["repo"] != "team" for e in hits)
    return sorted(hits[:n_repo], key=old) + sorted(hits[n_repo:], key=old)


def traps(args):
    repo = None
    if args[:1] == ["--repo"]:
        repo, args = (args[1:2] or [""])[0].replace("/", "__"), args[2:]
    if len(args) != 1 or repo == "":
        return usage()
    if not have_memory():
        return 0
    hits = trap_hits(repo, args[0])
    for e in hits:
        print(hit(e))
    if not hits:
        print("no match")
    log(cmd="traps", q=args[0], ids=[e["id"] for e in hits])
    return 0


def hook_query(text):
    """The distinct words of the last 40 lines, 3 chars or more, with no numbers or hex ids, at most 40."""
    toks = []
    for t in re.findall(r"[a-z0-9]+", "\n".join(text.splitlines()[-40:]).lower()):
        if len(t) >= 3 and t not in STOP and not t.isdigit() and not re.fullmatch(r"(?=.*[0-9])[0-9a-f]{6,}", t) and t not in toks:
            toks.append(t)
    return toks[:40]


def hook_paths(name, inp):
    """The file of a Claude edit, or the files of a Codex patch (Codex can name apply_patch Edit or Write too)."""
    if name not in ("Edit", "Write", "MultiEdit", "apply_patch"):
        return []
    if isinstance(inp.get("file_path"), str):
        return [inp["file_path"]]
    return re.findall(r"(?m)^\*\*\* (?:Add|Update|Delete) File: (.+?)\s*$", str(inp.get("command") or ""))


def package(p):
    """The first two parts under packages/ or libs/, else the first part, of the path from the top of the repo."""
    parts = re.sub(r"^/workspace/", "", rel_path(p)).split("/")
    return "/".join(parts[:2] if parts[0] in ("packages", "libs") else parts[:1])


def hook(_args):
    """Recall memory for a Claude or Codex hook event on stdin. Prints hookSpecificOutput or nothing, and always exits 0."""
    try:
        ev = json.loads(sys.stdin.read(200000))
        name, event, sid = ev.get("tool_name"), ev.get("hook_event_name"), str(ev.get("session_id", ""))
        try:
            with open(SEEN, encoding="utf-8") as fh:
                seen = set(l.strip() for l in fh if l.startswith(sid + " "))
        except OSError:
            seen = set()
        mark = []
        if name == "Bash" and event in ("PostToolUseFailure", "PostToolUse"):
            text, r = ev.get("error"), ev.get("tool_response")
            if event == "PostToolUse":
                if isinstance(r, dict):
                    r = "\n".join(v for v in (r.get(k) for k in ("output", "stderr", "stdout")) if isinstance(v, str))
                code = isinstance(r, str) and re.search(r"exit(ed)?( with)? code:? *([0-9]+)", r, re.I)
                # Codex 0.160 sends only the output, with no exit code: an error marker counts as a failure.
                text = r if isinstance(r, str) and (int(code.group(3)) != 0 if code else re.search(HOOK_ERR_RE, "\n".join(r.splitlines()[-40:]), re.I)) else None
            if not isinstance(text, str):
                return 0
            entries = load()
            by_id = {e["id"]: e for e in entries}
            hits = sorted((by_id[i] for i, sc in rank(entries, hook_query(text)) if sc >= HOOK_MIN_SCORE), key=old)
        elif event == "PreToolUse" and isinstance(ev.get("tool_input"), dict):
            hits = []
            for pkg in dict.fromkeys(package(p) for p in hook_paths(name, ev["tool_input"]) if p):
                if "%s pkg:%s" % (sid, pkg) not in seen:
                    mark.append("%s pkg:%s" % (sid, pkg))
                    hits += [e for e in trap_hits(None, pkg) if e not in hits]
        else:
            return 0
        hits = [e for e in hits if "%s %s" % (sid, e["id"]) not in seen][:3]
        mark += ["%s %s" % (sid, e["id"]) for e in hits]
        try:
            with open(SEEN, "a", encoding="utf-8") as fh:
                fh.writelines(m + "\n" for m in mark)
        except OSError:
            pass
        if hits:
            for e in hits:
                log(cmd="hook", id=e["id"], auto=True, event=event)
            ctx = "\n".join(["Team memory (auto):"] + [hit(e) for e in hits] + ["Run fxa-mem show <id> for the whole entry."])
            print(json.dumps({"hookSpecificOutput": {"hookEventName": event, "additionalContext": ctx}}))
    except Exception:
        pass
    return 0


def rate(args):
    if len(args) < 2:
        return usage()
    if args[1] not in RATINGS:
        print("rating must be one of: " + ", ".join(RATINGS))
        return 2
    if not any(e["id"] == args[0] for e in load()):
        print("unknown id %s" % args[0])
        return 1
    log(cmd="rate", id=args[0], rating=args[1], why=" ".join(args[2:])[:200])
    print("rated %s %s" % (args[0], args[1]))
    return 0


def edit_out(change):
    """Read the run's memory file (or a new one), apply change(doc), write it back. A file that is not JSON stays as it is."""
    doc = {"episode": {}, "learnings": [], "confirmed": []}
    if os.path.exists(OUT):
        try:
            with open(OUT, encoding="utf-8") as fh:
                doc = json.load(fh)
            assert isinstance(doc, dict)
        except (ValueError, AssertionError, OSError):
            print("%s is not valid JSON; fix or remove it" % OUT)
            return 1
    if not all(isinstance(doc.get(k, []), list) for k in ("learnings", "confirmed")):
        print("%s: learnings and confirmed must be lists; fix or remove it" % OUT)
        return 1
    change(doc)
    tmp = OUT + ".tmp"
    with open(tmp, "w", encoding="utf-8") as fh:
        json.dump(doc, fh, indent=1)
    os.replace(tmp, OUT)
    return 0


def propose(args):
    f, cites, anchors, team = {}, [], [], False
    while args:
        k = args[0][2:] if args[0].startswith("--") else ""
        if k == "team":
            team, args = True, args[1:]
        elif k in FLAGS and len(args) > 1:
            if k == "cite":
                cites.append(args[1])
            elif k == "anchor":
                anchors.append(args[1])
            else:
                f[k] = args[1]
            args = args[2:]
        else:
            break
    op = f.get("op", "add")
    if team:
        # A team fact: 1 to 3 cites, each owner/repo:path:line with its own anchor.
        ok = "repo" not in f and f.get("kind") in TEAM_KINDS and 1 <= len(cites) <= 3 and all(re.fullmatch(TEAM_CITE_RE, c) for c in cites)
    else:
        ok = bool(f.get("repo")) and f.get("kind") in KINDS and len(cites) == 1
    if not ok or args or len(cites) != len(anchors) or not all(cites + anchors) or any(not f.get(k) for k in NEED) \
            or op not in ("add", "update", "supersede") or (op == "add") != ("id" not in f) or ("id" in f and not re.fullmatch(ID_RE, f["id"])):
        return usage()
    if team:
        f["repo"], f["cites"] = "team", [{"cite": c, "anchor": a} for c, a in zip(cites, anchors)]
    else:
        f["cite"], f["anchor"] = cites[0], anchors[0]
    f["op"] = op
    f.setdefault("path", "")
    return edit_out(lambda d: d.setdefault("learnings", []).append({k: f[k] for k in FLAGS + ("cites",) if k in f}))


def confirm(args):
    if len(args) != 1 or not re.fullmatch(ID_RE, args[0]):
        return usage()
    return edit_out(lambda d: args[0] in d.setdefault("confirmed", []) or d["confirmed"].append(args[0]))


def usage():
    print("usage: fxa-mem search <words...> | show <id> | traps [--repo owner/repo] <path> | rate <id> helped|wrong|stale [why...]\n"
          "       fxa-mem propose --repo owner/repo --kind %s --text T --cite path:line --anchor A --why W --terms T [--path GLOB] [--op update|supersede --id mem-XXXXXXXX]\n"
          "       fxa-mem propose --team --kind %s --text T --cite owner/repo:path:line --anchor A [--cite ... --anchor ...] (up to 3) --why W --terms T [--path GLOB]\n"
          "       fxa-mem confirm <id>" % ("|".join(KINDS), "|".join(TEAM_KINDS)))
    return 2


def main(argv):
    cmds = dict(search=lambda a: search(a) if a else usage(), show=show, traps=traps, rate=rate, propose=propose, confirm=confirm, hook=hook)
    return cmds[argv[0]](argv[1:]) if argv and argv[0] in cmds else usage()


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
