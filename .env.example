# Copy to .env and fill in. .env is gitignored; this file is not.
# Existing environment variables win over anything set here.

# Required. Long-lived OAuth token for headless agent runs.
# Generate one with: claude setup-token
CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-...

# Optional. Local checkout that `jira --private` provisions worktrees from.
# Push and PR follow that checkout's own origin remote, so no repo slug is
# configured here. Leave unset if you do not use --private.
#FXA_PRIVATE_REPO=/path/to/second/checkout
