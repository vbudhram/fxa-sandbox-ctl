# Copy to .env and fill in. .env is gitignored; this file is not.
# Existing environment variables win over anything set here.

# Required. Long-lived OAuth token for headless agent runs.
# Generate one with: claude setup-token
CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-...

# Optional. Local checkout that `jira --private` provisions worktrees from.
# Push and PR follow that checkout's own origin remote, so no repo slug is
# configured here. Leave unset if you do not use --private.
#FXA_PRIVATE_REPO=/path/to/second/checkout

# Optional. Which agent runs inside the VM: claude (default) or codex.
# Per-launch: fxa-sandbox-ctl jira <KEY> --runtime codex
#FXA_AGENT_RUNTIME=codex

# Optional. Model for Codex runs; written into the VM's config.toml.
#FXA_CODEX_MODEL=gpt-6-astra

# Codex authenticates from ~/.codex/auth.json (run `codex login` on the host).
# A launch refuses to start if the access token has under this many hours left,
# so a run never has to refresh it inside the VM.
#FXA_CODEX_MIN_TOKEN_HOURS=3

# Optional. Which VM backend runs the agent: tart (default) or gce.
# Per-launch: fxa-sandbox-ctl --backend gce jira <KEY>
#FXA_VM_BACKEND=gce
# Required for gce. Run infra/gce/setup.sh once per project.
#FXA_GCE_PROJECT=
# State mirror and pause marker bucket. Default: gs://<FXA_GCE_PROJECT>-fxa-ai-fixme.
#PIPE_STATE_BUCKET=
# Manager service account, created by infra/gce/setup.sh. Unset: your own account.
#FXA_GCE_SERVICE_ACCOUNT=fxa-ai-fixme-manager@<project-id>.iam.gserviceaccount.com
#FXA_GCE_ZONE=us-central1-a
# Zones tried in order on a stockout; all must be in the network's region (default: us-central1-a b c f).
#FXA_GCE_ZONES=
#FXA_GCE_IMAGE=fxa-dev-base
#FXA_GCE_MACHINE_TYPE=c4a-highcpu-4
# Hard lifetime for a gce runner in seconds; GCE deletes it at this age (default 5400).
#FXA_GCE_MAX_RUN_SECONDS=5400
# ssh key the gce backend uses through the IAP tunnel; generated if missing (default ~/.ssh/fxa-sandbox-gce).
#FXA_GCE_SSH_KEY=

# Optional. Cap on the rendered /goal prompt. Claude Code refuses over 4000 (default 4000).
#FXA_GOAL_MAX_CHARS=4000

# Optional. GitHub App the pipeline will commit and open PRs as. All three must be
# set for it to be used; finish does not use it yet. Keep the .pem outside any repo.
#GITHUB_APP_ID=
#GITHUB_APP_PEM=/path/to/github-app.pem
#GITHUB_APP_INSTALLATION_ID=
