  echo "Running: npx playwright test --project=local --project=local-chromium${args} (in ${name})"
  vm_exec_as_agent "$name" "source /etc/agent-env.sh && cd /workspace/packages/functional-tests && NODE_OPTIONS=--dns-result-order=ipv4first npx playwright test --project=local --project=local-chromium${args}"
