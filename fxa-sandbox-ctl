#!/bin/bash
# fxa-sandbox-ctl: orchestration CLI for the FxA agent sandbox VMs.
set -euo pipefail

# Follow symlinks so lib/ is found next to the real script.
_resolve_symlink() {
  local target="$1"
  while [ -L "$target" ]; do
    local dir="$(cd "$(dirname "$target")" && pwd)"
    target="$(readlink "$target")"
    [[ "$target" != /* ]] && target="$dir/$target"
  done
  echo "$target"
}
SCRIPT_DIR="$(cd "$(dirname "$(_resolve_symlink "${BASH_SOURCE[0]}")")" && pwd)"

# Load KEY=VALUE lines from .env. A variable already set in the shell wins.
if [ -f "${SCRIPT_DIR}/.env" ]; then
  # `|| [ -n "$_env_key" ]` handles a final line that has no trailing newline.
  while IFS='=' read -r _env_key _env_val || [ -n "$_env_key" ]; do
    case "$_env_key" in
      ''|\#*) continue ;;
    esac
    _env_val="${_env_val%\"}"; _env_val="${_env_val#\"}"
    _env_val="${_env_val%\'}"; _env_val="${_env_val#\'}"
    if [ -z "${!_env_key:-}" ]; then
      export "${_env_key}=${_env_val}"
    fi
  done < "${SCRIPT_DIR}/.env"
  unset _env_key _env_val
fi

source "${SCRIPT_DIR}/lib/config.sh"
source "${SCRIPT_DIR}/lib/vm.sh"
source "${SCRIPT_DIR}/lib/agent.sh"
source "${SCRIPT_DIR}/lib/pipeline.sh"
source "${SCRIPT_DIR}/lib/jira.sh"
source "${SCRIPT_DIR}/lib/worktree.sh"
source "${SCRIPT_DIR}/lib/github.sh"
source "${SCRIPT_DIR}/lib/telemetry.sh"
source "${SCRIPT_DIR}/lib/snapshot.sh"
source "${SCRIPT_DIR}/lib/circleci.sh"
source "${SCRIPT_DIR}/lib/finish.sh"
source "${SCRIPT_DIR}/lib/errors.sh"
source "${SCRIPT_DIR}/lib/lessons.sh"
source "${SCRIPT_DIR}/lib/alerts.sh"
source "${SCRIPT_DIR}/lib/db.sh"
source "${SCRIPT_DIR}/lib/llm-token.sh"
source "${SCRIPT_DIR}/lib/mcp-token.sh"
source "${SCRIPT_DIR}/lib/session.sh"
source "${SCRIPT_DIR}/lib/answer.sh"

