# ── Command: status ────────────────────────────────────────────

cmd_status() {
  echo "=== FxA Agent Sandbox Status ==="
  echo ""

  # Host memory
  local total_mem_bytes
  total_mem_bytes=$(sysctl -n hw.memsize 2>/dev/null || echo 0)
  local total_mem_gb=$(( total_mem_bytes / 1024 / 1024 / 1024 ))

  echo "Host: macOS $(sw_vers -productVersion 2>/dev/null || echo 'unknown'), ${total_mem_gb}GB RAM"
  echo ""

  # Golden image
  if vm_image_exists; then
    echo "Golden image: installed"
  else
    echo "Golden image: NOT INSTALLED (run: fxa-sandbox-ctl image build)"
  fi
  echo ""

  # Running agents
  echo "Agents:"
  agent_list
  echo ""

  # Worktree pool: which slots are free vs. claimed by a running agent.
  echo "Worktree pool:"
  local slot agent_name any_slot=0
  while IFS= read -r slot; do
    [ -z "$slot" ] && continue
    any_slot=1
    agent_name="$(_worktree_agent_for_workspace "$slot")"
    if [ -n "$agent_name" ]; then
      printf '  [busy] %s  (agent: %s)\n' "$slot" "$agent_name"
    else
      printf '  [free] %s\n' "$slot"
    fi
  done < <(_worktree_pool_list)
  [ "$any_slot" -eq 0 ] && echo "  (no pool worktrees yet)"
  echo ""

  # Stale host state: .meta files whose VM is no longer running.
  local meta name stale=()
  for meta in "${LOG_DIR}"/*.meta; do
    [ -f "$meta" ] || continue
    name="$(basename "$meta" .meta)"
    vm_is_running "$name" 2>/dev/null || stale+=("$name")
  done
  if [ "${#stale[@]}" -gt 0 ]; then
    echo "Stale agent state (VM not running) — clean up with 'fxa-sandbox-ctl reap':"
    printf '  - %s\n' "${stale[@]}"
    echo ""
  fi
}

# ── Command: reap ──────────────────────────────────────────────

# Remove leftover host-side state (.meta / .pid / VM log / SSH keys) for agents
# whose VM is no longer running. Never touches a running agent. Run this only
# when no agent is mid-boot: a VM that hasn't reported an IP yet reads as "not
# running", so reaping during startup could delete a live agent's state.
_reap_stale_state() {
  local meta name reaped=0
  for meta in "${LOG_DIR}"/*.meta; do
    [ -f "$meta" ] || continue
    name="$(basename "$meta" .meta)"
    if vm_is_running "$name" 2>/dev/null; then
      continue
    fi
    echo "Reaping stale agent '${name}' (VM not running)..."
    rm -f "${LOG_DIR}/${name}.meta" \
          "${LOG_DIR}/${name}.pid" \
          "${LOG_DIR}/${name}-vm.log"
    rm -rf "${LOG_DIR}/ssh/${name}"
    reaped=$(( reaped + 1 ))
  done
  if [ "$reaped" -eq 0 ]; then
    echo "Nothing to reap — no stale agent state found."
  else
    echo "Reaped ${reaped} stale agent(s)."
  fi
}

# ── Pipeline commands ──────────────────────────────────────────
#
# These drive a ticket-to-PR pipeline (see pipelines/*.conf). They used to live
# in the fxa-ai-fixme skill's fixme.sh, which carried its own copies of the
# branch naming, the pool logic, and VM reaping. There is now one copy of each.
#
# Every command here is read-only unless its comment says otherwise. Nothing
# here merges or approves a PR, and nothing here prints a secret.

cmd_reap() {
  case "${1:-}" in
    '')       _reap_stale_state ;;
    --stray)  _reap_stray_vms ;;
    *)        _reap_key "$1" ;;
  esac
}

# _reap_key <KEY>
#   WRITE: stop the agent VM that belongs to <KEY>. Idempotent: prints `no-vm`
#   and exits 0 when nothing is running, so a pass can call it unconditionally.
#
#   Nothing else in the system does this. `finish` runs
#   handoff -> push -> PR -> watch-CI -> exit and never stops the VM; it even
#   prints "the agent keeps running". So a finished agent sits at its prompt at
#   0% CPU holding its slot and 8-13GB forever. With two slots the pool
#   deadlocks after two launches and every later pass is a no-op. On 2026-08-24
#   two VMs idled 4+ hours and eight consecutive passes did nothing.
#
#   Set FXA_NO_REAP=1 to keep a VM alive while debugging a failed run.
_reap_key() {
  local key="$1"
  if [ "${FXA_NO_REAP:-}" = "1" ]; then echo "$key reap-skipped (FXA_NO_REAP=1)"; return 0; fi
  local name; name="$(worktree_branch_for "$key")" || return 1
  if ! vm_is_running "$name" 2>/dev/null; then echo "$key no-vm"; return 0; fi
  # Never fail a pass on a reap. A stuck VM is a smaller problem than a pass
  # that aborts halfway through its label writes.
  if agent_stop "$name" >/dev/null 2>&1; then
    echo "$key reaped ($name)"
  else
    echo "$key reap-failed ($name) -- stop it by hand" >&2
  fi
}

# _reap_stray_vms
#   WRITE: stop every running agent VM whose ticket is not inflight. Prints one
#   line per VM it touched, nothing when the pool is clean.
#
#   The reap inside `label` covers the normal path, but it only fires when a
#   pass actually performs the transition. This catches everything else: a pass
#   that died between the launch and the reconcile, a label edited by hand in
#   Jira, a run that finished with no pass after it, or a VM whose branch maps
#   to no labelled ticket at all.
#
#   `inflight` is the protection. A pass labels a ticket inflight before it
#   launches and the label holds for the whole run, including the host's push
#   and PR handoff, so a live run can never be collected here.
_reap_stray_vms() {
  if [ "${FXA_NO_REAP:-}" = "1" ]; then echo "reapstray skipped (FXA_NO_REAP=1)"; return 0; fi
  local owned; owned="$(jira_owning_keys)"
  if [ "$owned" = "UNKNOWN" ]; then
    echo "ERROR: cannot list inflight tickets; refusing to stop any VM." >&2
    return 1
  fi
  local name key
  while IFS= read -r name; do
    [ -z "$name" ] && continue
    # Only agent names that look like a branch for a ticket. Anything else is a
    # hand-started agent and none of this pipeline's business.
    case "$name" in
      [a-z]*-[0-9]*) ;;
      *) continue ;;
    esac
    key="$(worktree_key_for "$name")"
    if printf '%s\n' "$owned" | grep -qx "$key"; then
      continue                        # live run, protected by its label
    fi
    if agent_stop "$name" >/dev/null 2>&1; then
      echo "$key stray-reaped ($name)"
    else
      echo "$key stray-reap-failed ($name) -- stop it by hand" >&2
    fi
  done <<< "$(_worktree_each_active_agent | awk '{print $1}')"
  vm_gc
}

cmd_queue()     { jira_queue_keys; }
cmd_inflight()  { jira_inflight_keys; }

# cmd_reconcile
#   WRITE: apply the determinate rows of the reconcile table to every inflight
#   key and print one line per key. Merged, closed, and green PRs move their
#   label; an inflight label with no launch log goes back to public. Everything
#   that needs a judgement (stalls, red checks, a dead runner) is printed as is
#   for the pass to decide. Until this existed the table lived only in the
#   skill, so a label frozen while the automation was off stayed frozen until a
#   human read it (FXA-14300 shipped twice that way on 2026-09-08).
cmd_reconcile() {
  local key line stage pr state ok fail run url why
  for key in $(jira_inflight_keys); do
    line="$(pipeline_progress "$key")"; stage="$(printf '%s' "$line" | awk '{print $2}')"
    case "$stage" in
      pr)
        read -r _ pr state ok fail run <<< "$(gh_pr_state "$key")"
        case "$state" in
          MERGED) cmd_label "$key" merged >/dev/null && echo "$key merged #$pr" ;;
          CLOSED) cmd_label "$key" rejected >/dev/null && echo "$key rejected #$pr" ;;
          OPEN)
            if [ "${fail#fail=}" = 0 ] && [ "${run#running=}" = 0 ] && [ "${ok#ok=}" -gt 0 ]; then
              cmd_label "$key" done >/dev/null && echo "$key done #$pr green"
            elif url="$(gh_gate_stuck "$key" 0)"; then
              # Every push resets the functional-tests gate, and the launcher
              # approves it only on its own first push. Approve any pending gate
              # here, so a feedback or rebase round does not wait a pass for it.
              finish_approve_functional_gate "$url" 2>/dev/null
              echo "$key pr #$pr gate approved"
            elif [ "${fail#fail=}" -gt 0 ]; then
              if why="$(gh_red_infra "$key")"; then
                # Every red check is repo infrastructure, not this PR. Once
                # nothing else is still running, treat it as green.
                if [ "${run#running=}" = 0 ]; then
                  cmd_label "$key" done >/dev/null && echo "$key done #$pr green except infra: $why"
                else
                  echo "$key pr #$pr RED-INFRA $why; not this PR"
                fi
              else
                echo "$key pr #$pr RED $ok $fail $run"
              fi
            else
              echo "$key pr #$pr $ok $fail $run"
            fi ;;
          *) echo "$key pr $pr $state (could not read the PR)" ;;
        esac ;;
      nolog) cmd_label "$key" public >/dev/null && echo "$key public (inflight with no launch log)" ;;
      watching)
        if vm_is_running "$(worktree_branch_for "$key")" 2>/dev/null; then echo "$line"
        else echo "$key dead-runner (no VM, no PR); the slot holds the last pulled tree, a relaunch resumes it"; fi ;;
      *) echo "$line" ;;
    esac
  done
  # Every pass reconciles, so this is where a stale skip record dies.
  jira_queue_keys 2>/dev/null | pipeline_skip_prune
}
cmd_done_keys() { jira_done_keys; }

# precheck
#   The whole deterministic half of a pass, in shell, so a quiet pass costs the
#   operator's model nothing. Takes the lock, applies the reconcile rows, drains
#   `done`, reaps strays, then lists what still needs judgment: a reconcile or
#   drain line, a stray reap, a review comment not noted before, a queue key
#   with no skip record, or a skipped ticket whose text changed since the skip.
#   Prints `quiet` and one status line when nothing does. The cron prompt calls
#   this first and invokes the skill only on work: on 2026-09-15 fourteen idle
#   passes in a row each re-injected the 61KB skill into a 400K-token session
#   for no result.
#
#   Newly noted review comments are remembered in <KEY>.feedback-noted, so a
#   comment the pass has already reported (a question waiting on a human) does
#   not make every later pass loud. `label done` clearing feedback-seen does
#   not touch this file; a round that fixes a comment removes it from the
#   feedback list, and the next new one is a new id.
cmd_precheck() {
  local out; out="$(pipeline_lock)" || { echo "$out"; return 1; }
  local work=0 info="" line key num state ids noted why
  local inflight_pr=0 infra=0 merged_n=0 rejected_n=0
  _work() { work=1; printf '%s\n' "$*"; }
  # Informational lines are held back and printed only when something else needs
  # judgment. A pass that has only these prints one `quiet` line, so an idle
  # fire costs one short model turn instead of a lock/drain/sweep/unlock turn.
  _info() { info="${info}${info:+$'\n'}$*"; }
  # Reconcile lines that need a human or model judgment. Everything else the
  # reconcile already applied (merged, done, gate approved) or is progress.
  local judge_re='dead-runner| RED |could not read|exited-without-handoff|stalled|public \(inflight'

  while IFS= read -r line; do
    [ -n "$line" ] || continue
    case "$line" in *" pr #"*) inflight_pr=$((inflight_pr + 1)) ;; esac
    case "$line" in *RED-INFRA*) infra=$((infra + 1)) ;; esac
    if printf '%s' "$line" | grep -qE "$judge_re"; then _work "reconcile: $line"; else _info "reconcile: $line"; fi
  done < <(cmd_reconcile 2>&1)

  # Drain rows that are determinate get applied here, not narrated. The skill
  # says a MERGED line takes `label merged` and a CLOSED line takes `label
  # rejected` with no judgment in between; a model turn to type that cost about
  # $0.40 per merge on 2026-09-17.
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    read -r key num state _ <<< "$line"
    case "$state" in
      MERGED) if cmd_label "$key" merged >/dev/null 2>&1; then merged_n=$((merged_n + 1)); _info "drain: $key merged #$num (labelled, ticket closed)"; else _work "drain: $line (label merged FAILED)"; fi ;;
      CLOSED) if cmd_label "$key" rejected >/dev/null 2>&1; then rejected_n=$((rejected_n + 1)); _info "drain: $key rejected #$num (labelled)"; else _work "drain: $line (label rejected FAILED)"; fi ;;
      RED)    if why="$(gh_red_infra "$key")"; then infra=$((infra + 1)); _info "drain: $key $num RED-INFRA $why"; else _work "drain: $line"; fi ;;
      *)      _work "drain: $line" ;;
    esac
  done < <(cmd_drain 2>&1)
  while IFS= read -r line; do [ -n "$line" ] && _work "reap: $line"; done < <(cmd_reap --stray 2>&1)

  # Sweep review feedback on every ticket with an open PR: `done`, and `inflight`
  # whose runner has handed off. A red check keeps a ticket at inflight for days,
  # and its review comments were invisible until 2026-09-17.
  local done_keys sweep; done_keys="$(jira_done_keys)"; sweep="$done_keys"
  for key in $(jira_inflight_keys); do
    [ "$(pipeline_progress "$key" 2>/dev/null | awk '{print $2}')" = "pr" ] && sweep="${sweep}${sweep:+ }${key}"
  done
  for key in $sweep; do
    ids="$(gh_feedback "$key" 2>/dev/null | jq -r '(.comments // [])[].id' | sort)"
    noted="${PIPE_STATE_DIR}/${key}.feedback-noted"
    if [ -n "$ids" ] && [ "$ids" != "$(cat "$noted" 2>/dev/null)" ]; then
      _work "feedback: $key has new review comments: $(printf '%s' "$ids" | tr '\n' ' ')(run: feedback $key bundle)"
      printf '%s\n' "$ids" > "$noted"
    fi
  done

  # Each fingerprint is two Jira reads, and 20 keys serially took 85 s. xargs -P
  # fans them out through the `skip-changed` subcommand; bash 3.2 has no `wait -n`.
  # A key with no record or a changed ticket prints a line, an unchanged one
  # prints nothing, so the output is exactly the worklist.
  local queue; queue="$(jira_queue_keys)"
  while IFS= read -r line; do [ -n "$line" ] && _work "queue: $line (run: ground ${line%% *})"; done < <(
    printf '%s\n' $queue | grep . \
      | xargs -P 8 -I{} "$0" --pipeline "$PIPE_NAME" skip-changed {} 2>/dev/null | sort)

  pipeline_unlock >/dev/null
  local pass=""
  [ "$merged_n" -gt 0 ] && pass="${pass}; this pass: ${merged_n} merged"
  [ "$rejected_n" -gt 0 ] && pass="${pass}${pass:+,}${pass:+ }${pass:-; this pass: }${rejected_n} rejected"
  if [ "$work" = 0 ]; then
    echo "quiet: $(printf '%s\n' $queue | grep -c .) queued (all skipped, unchanged), $(printf '%s\n' $done_keys | grep -c .) awaiting review, $(jira_inflight_keys | grep -c .) in flight (${inflight_pr} with PR, ${infra} red on known infra)${pass}"
  else
    [ -n "$info" ] && printf '%s\n' "$info"
  fi
}

# Every key reaches JQL, file paths, and a python argv. One gate, applied once.
_key() { local k; k="$(jira_normalize_key "${1:-}")" || exit 1; printf '%s' "$k"; }
cmd_ticket()    { jira_ticket "$(_key "$1")"; }
cmd_reporter()  { jira_reporter_login "$(_key "$1")"; }
cmd_drain()     { gh_drain "$(jira_done_keys)"; }
cmd_prstate()   { gh_pr_state "$(_key "$1")"; }
cmd_conflicts() { gh_conflicts "$(_key "$1")" "${@:2}"; }
cmd_feedback()  {
  if [ "${2:-}" = "bundle" ]; then cmd_feedback_bundle "$(_key "$1")"; else gh_feedback "$(_key "$1")" "${@:2}"; fi
}
cmd_progress()  { pipeline_progress "$(_key "$1")"; }
cmd_lock()      { pipeline_lock; }
cmd_unlock()    { pipeline_unlock; }
cmd_pause()     { pipeline_pause "$@"; }
cmd_resume()    { pipeline_resume; }
cmd_paused()    { pipeline_paused; }
cmd_skip()      { pipeline_skip "$(_key "$1")" "${@:2}"; }
cmd_skip_changed() {
  local key; key="$(_key "$1")"; local why
  if why="$(pipeline_skip_changed "$key")"; then echo "$key $why"; fi
}
cmd_skipped()   { if [ -n "${1:-}" ]; then pipeline_skipped "$(_key "$1")"; else pipeline_skipped; fi; }
cmd_attempts()  { pipeline_attempts "$(_key "$1")" "${@:2}"; }
cmd_usage_tokens() { telemetry_usage "$@"; }
cmd_record()    { telemetry_record "$(_key "$1")"; }
cmd_costs()     { telemetry_costs; }
cmd_slots()     { worktree_slots; }
cmd_snapshot()  {
  case "${1:-}" in
    --agents) snapshot_agents_json ;;
    *)        snapshot_json ;;
  esac
}

# cmd_dashboard [--port N] [--interval S]
#   Serve the status page from live snapshots. Binds to 127.0.0.1 only: the
#   snapshot carries ticket text and branch names, and nothing here authenticates.
cmd_dashboard() {
  local port=8787 interval=60
  while [ "$#" -gt 0 ]; do
    case "$1" in
      -p|--port)     port="$2"; shift 2 ;;
      -i|--interval) interval="$2"; shift 2 ;;
      *) echo "ERROR: unknown dashboard option: $1" >&2; return 1 ;;
    esac
  done
  command -v python3 >/dev/null 2>&1 || { echo "ERROR: python3 is required for the dashboard." >&2; return 1; }
  exec python3 "${SCRIPT_DIR}/dashboard/server.py" "$port" "$PIPE_NAME" "$interval"
}

# Slots a ticket can actually claim. Use this, never `slots`: `slots` only
# answers whether a VM is running there.
# launchcap: how many launches this pass may make, resolved against the backend.
# 0 in the config means "one per free slot", so the pass reads this and never
# the config directly.
cmd_launchcap() {
  local cap
  case "${FXA_VM_BACKEND:-tart}" in
    gce) cap="${PIPE_MAX_LAUNCHES_GCE:-5}" ;;
    *)   cap="${PIPE_MAX_LAUNCHES_TART:-1}" ;;
  esac
  local free; free="$(cmd_freeslots 2>/dev/null | grep -c . || true)"
  [ "${free:-0}" -lt "$cap" ] && cap="$free"
  echo "${cap:-0}"
}

cmd_freeslots() {
  local owned; owned="$(jira_owning_keys)"
  if [ "$owned" = "UNKNOWN" ]; then
    echo "ERROR: cannot list inflight tickets; refusing to call any slot free." >&2
    return 1
  fi
  worktree_free_slots "$owned"
  # gce: the pool grows to the launch cap. List the next-numbered slots that do
  # not exist yet; `launch <KEY> <slot>` creates a named slot on demand. A slot
  # is a checkout with no node_modules, so this costs disk and a minute, not RAM.
  if [ "${FXA_VM_BACKEND:-tart}" = "gce" ]; then
    local cap="${PIPE_MAX_LAUNCHES_GCE:-5}" existing n=1
    existing="$(worktree_pool_slot_names | grep -c . || true)"
    local free_now; free_now="$(worktree_free_slots "$owned" | grep -c . || true)"
    while [ $(( free_now )) -lt "$cap" ] && [ $(( existing + n - 1 )) -lt "$cap" ]; do
      printf '%s-%s\n' "$FXA_SHARED_WORKTREE_NAME" $(( existing + n ))
      n=$(( n + 1 )); free_now=$(( free_now + 1 ))
    done
  fi
}

cmd_alive() {
  local key="${1:-}"; [ -n "$key" ] || { echo "ERROR: alive needs <KEY>" >&2; return 1; }
  local name; name="$(worktree_branch_for "$key")" || return 1
  if ! vm_is_running "$name" 2>/dev/null; then echo "$key no-vm"; return 1; fi
  if agent_alive "$name"; then echo "$key alive"; return 0; fi
  echo "$key dead"; return 1
}

# _ground_paths <TEXT>
#   Repo-relative paths a ticket or comment cites, one per line, optionally
#   `path:LINE` or `path:LINE-LINE`. Trailing punctuation stripped.
_ground_paths() {
  printf '%s\n' "$1" \
    | grep -oE '(packages|libs|_scripts|_dev|\.github|\.circleci|scripts)/[A-Za-z0-9_./@-]+(:[0-9]+(-[0-9]+)?)?' \
    | sed -E 's/[.,;:)]+$//' | sort -u || true
}

# cmd_ground <KEY>
#   Write /tmp/fxa-KEY-ground.md: the ticket, every cited path checked against
#   origin/main with the cited lines shown, frozen and stories checks, open PRs
#   touching the same files, and recent commits to them. One read replaces the
#   six to ten greps a grounding pass ran by hand, and each of those greps was a
#   model turn re-reading the whole session. Read-only; nothing here decides.
cmd_ground() {
  local key; key="$(_key "$1")"
  local out="/tmp/fxa-${key}-ground.md" repo="$PIPE_REPO"
  git -C "$repo" fetch -q origin main 2>/dev/null || true
  local ticket; ticket="$(jira_ticket "$key" 2>/dev/null)"
  local reporter; reporter="$(jira_reporter_login "$key" 2>/dev/null || true)"
  local skiprec; skiprec="$(pipeline_skipped "$key" 2>/dev/null || true)"
  local paths; paths="$(_ground_paths "$ticket" || true)"
  local n_cited=0 n_missing=0 n_frozen=0 n_stories=0 n_prs=0
  {
    echo "# ${key} grounding bundle, origin/main $(git -C "$repo" rev-parse --short origin/main) at $(date -u +%FT%TZ)"
    echo "reporter_login: ${reporter:-<unmapped>}"
    echo "skip record: ${skiprec:-none}"
    echo; echo "## Ticket"; echo; printf '%s\n' "$ticket"
    echo; echo "## Cited paths on origin/main"; echo
    local ref path lines lo hi
    while IFS= read -r ref; do
      [ -n "$ref" ] || continue
      n_cited=$((n_cited + 1))
      path="${ref%%:*}"; lines="${ref#*:}"; [ "$lines" = "$ref" ] && lines=""
      if git -C "$repo" cat-file -e "origin/main:${path}" 2>/dev/null; then
        echo "- exists  ${ref}"
        if [ -n "$lines" ]; then
          lo="${lines%%-*}"; hi="${lines##*-}"; [ "$hi" -ge "$lo" ] 2>/dev/null || hi="$lo"
          git -C "$repo" show "origin/main:${path}" | sed -n "${lo},${hi}p" | sed 's/^/      | /'
        fi
      else
        n_missing=$((n_missing + 1)); echo "- MISSING ${ref}"
        local base; base="$(basename "$path")"
        git -C "$repo" ls-tree -r --name-only origin/main | grep -F "/${base}" | head -3 | sed 's/^/      maybe: /' || true
      fi
    done <<< "$paths"
    echo; echo "## Frozen paths (from _scripts/check-frozen.ts on origin/main)"; echo
    local frozen pat p
    frozen="$(git -C "$repo" show origin/main:_scripts/check-frozen.ts 2>/dev/null | grep -oE "pattern: '[^']+'" | sed -E "s/pattern: '//; s/'$//" || true)"
    while IFS= read -r pat; do
      [ -n "$pat" ] || continue
      while IFS= read -r p; do
        p="${p%%:*}"; [ -n "$p" ] || continue
        if printf '%s' "$p" | grep -qE "^${pat}"; then n_frozen=$((n_frozen + 1)); echo "- FROZEN ${p}  (pattern ${pat})"; fi
      done <<< "$paths"
    done <<< "$frozen"
    [ "$n_frozen" = 0 ] && echo "- none of the cited paths is frozen"
    echo; echo "## Stories beside cited files"; echo
    local d
    for d in $(printf '%s\n' "$paths" | sed -E 's/:.*$//' | xargs -n1 dirname 2>/dev/null | sort -u); do
      if git -C "$repo" ls-tree -r --name-only origin/main -- "$d" 2>/dev/null | grep -q '\.stories\.tsx$'; then
        n_stories=$((n_stories + 1)); echo "- ${d} has *.stories.tsx: ask for /fxa-storybook-capture if rendered output changes"
      fi
    done
    [ "$n_stories" = 0 ] && echo "- none"
    echo; echo "## Open PRs touching cited files"; echo
    local prfiles; prfiles="$(gh pr list --repo "$PIPE_REPO_SLUG" --state open --limit 60 --json number,title,headRefName,files \
      --jq '.[] | .number as $n | .headRefName as $b | .title as $t | .files[].path | "\(.)\t#\($n) \($b): \($t)"' 2>/dev/null || true)"
    local overlaps; overlaps="$(while IFS= read -r p; do
      p="${p%%:*}"; [ -n "$p" ] || continue
      printf '%s\n' "$prfiles" | awk -F'\t' -v f="$p" '$1 == f {print "- " f "  <- " $2}'
    done <<< "$paths" | sort -u)"
    if [ -n "$overlaps" ]; then printf '%s\n' "$overlaps"; else echo "- none"; fi
    echo; echo "## Commits to cited files in the last 30 days"; echo
    local existing; existing="$(while IFS= read -r p; do p="${p%%:*}"; [ -n "$p" ] && git -C "$repo" cat-file -e "origin/main:${p}" 2>/dev/null && printf '%s\n' "$p"; done <<< "$paths"; true)"
    if [ -n "$existing" ]; then
      git -C "$repo" log origin/main --since=30.days --date=short --format='- %h %ad %an: %s' -- $existing 2>/dev/null | head -15
    else
      echo "- (no cited path exists on main)"
    fi
  } > "$out" 2>/dev/null
  n_prs="$(grep -c '  <- #' "$out" || true)"
  echo "$out"
  echo "cited=${n_cited} missing=${n_missing} frozen=${n_frozen} stories_dirs=${n_stories} open_pr_overlaps=${n_prs}"
}

# cmd_feedback_bundle <KEY>
#   Write /tmp/feedback/fxa-KEY-bundle.md: each unhandled review comment with the
#   branch lines it sits on, and every `file:line` it cites resolved on the branch
#   and on origin/main. Verification then is one read, not a tool call per claim.
cmd_feedback_bundle() {
  local key="$1" repo="$PIPE_REPO"
  local br; br="$(worktree_branch_for "$key")"
  local fb; fb="$(gh_feedback "$key" 2>/dev/null)" || fb='{}'
  local pr; pr="$(printf '%s' "$fb" | jq -r '.pr // "none"')"
  local n; n="$(printf '%s' "$fb" | jq -r '(.comments // []) | length')"
  mkdir -p /tmp/feedback
  local out="/tmp/feedback/fxa-${key}-bundle.md"
  git -C "$repo" fetch -q origin main "$br" 2>/dev/null || true
  _show_ref() { # <rev> <path-or-suffix> <lo> <hi>
    local rev="$1" want="$2" lo="$3" hi="$4" f
    f="$(git -C "$repo" ls-tree -r --name-only "$rev" 2>/dev/null | grep -E "(^|/)$(printf '%s' "$want" | sed 's/[.[\*^$]/\\&/g')$" | head -1 || true)"
    [ -n "$f" ] || { echo "      (not found on ${rev})"; return 0; }
    echo "      ${rev}:${f}"
    git -C "$repo" show "${rev}:${f}" 2>/dev/null | sed -n "${lo},${hi}p" | awk -v s="$lo" '{printf "      %5d | %s\n", NR+s-1, $0}'
  }
  {
    echo "# ${key} review feedback bundle, PR #${pr}, branch ${br}, rounds used $(gh_feedback "$key" rounds 2>/dev/null)"
    echo "unhandled comments: ${n}"
    local i=0 id author assoc trusted path line body lo hi ref rp rl
    while [ "$i" -lt "$n" ]; do
      id="$(printf '%s' "$fb" | jq -r ".comments[$i].id")"; author="$(printf '%s' "$fb" | jq -r ".comments[$i].author")"
      assoc="$(printf '%s' "$fb" | jq -r ".comments[$i].association")"; trusted="$(printf '%s' "$fb" | jq -r ".comments[$i].trusted")"
      path="$(printf '%s' "$fb" | jq -r ".comments[$i].path // \"\"")"; line="$(printf '%s' "$fb" | jq -r ".comments[$i].line // 0")"
      body="$(printf '%s' "$fb" | jq -r ".comments[$i].body")"
      echo; echo "## [${id}] ${author} (${assoc}, trusted=${trusted}) on ${path}:${line}"; echo
      echo '```'; printf '%s\n' "$body"; echo '```'
      if [ -n "$path" ] && [ "$line" -gt 0 ] 2>/dev/null; then
        lo=$((line > 8 ? line - 8 : 1)); hi=$((line + 8))
        echo; echo "### Branch context ${path}:${lo}-${hi}"
        _show_ref "origin/${br}" "$path" "$lo" "$hi"
      fi
      local refs; refs="$(printf '%s\n' "$body" | grep -oE '[A-Za-z0-9_./-]+\.(ts|tsx|js|mjs|jsx|json|md|yml|yaml|mustache|sql):[0-9]+(-[0-9]+)?' | sort -u || true)"
      if [ -n "$refs" ]; then
        echo; echo "### Cited references"
        while IFS= read -r ref; do
          [ -n "$ref" ] || continue
          rp="${ref%%:*}"; rl="${ref#*:}"; lo="${rl%%-*}"; hi="${rl##*-}"; [ "$hi" -ge "$lo" ] 2>/dev/null || hi="$lo"
          echo "- ${ref}"; _show_ref "origin/${br}" "$rp" "$lo" "$hi"; _show_ref origin/main "$rp" "$lo" "$hi"
        done <<< "$refs"
      fi
      i=$((i + 1))
    done
  } > "$out" 2>/dev/null
  unset -f _show_ref
  echo "$out"; echo "pr=#${pr} unhandled=${n}"
}

# cmd_label <KEY> <STATE>
#   WRITE: move the ticket to <STATE>, then do the two things that must never
#   be separated from that move.
cmd_label() {
  local key="${1:-}" state="${2:-}"
  jira_label_set "$key" "$state" || return 1
  state="${state#${PIPE_LABEL_PREFIX}-}"
  [ "$state" = "$PIPE_LABEL_PREFIX" ] && state="public"
  # Any state other than inflight means this ticket no longer owns a worktree,
  # so its VM must go. Tying the reap to the label write is deliberate: a rule
  # that depends on a pass remembering to run a separate command does not
  # survive a cron-fired pass.
  if [ "$state" != "inflight" ]; then
    _reap_key "$key"
  fi
  # Reaching `done` means the fix is pushed and green, so this is the moment the
  # 👍 becomes truthful. Tied to the label write for the same reason as the
  # reap. No-ops for a ticket that never had feedback.
  if [ "$state" = "done" ] && gh_feedback_has_acted "$key"; then
    gh_feedback "$key" thumbsup
  fi
  # `done` is the last moment the slot still holds this run's transcript: the
  # next launch on the slot truncates it. Record the run here, every time.
  if [ "$state" = "done" ]; then
    telemetry_record "$key" >/dev/null 2>&1 || echo "WARN: telemetry_record failed for $key" >&2
  fi
  # `merged` closes the loop on the ticket: say what landed and what it cost.
  if [ "$state" = "merged" ]; then
    if ! jq -e --arg k "$key" 'select(.issue == $k)' "$PIPE_RUNS_FILE" >/dev/null 2>&1; then
      telemetry_record "$key" >/dev/null 2>&1 || true
    fi
    local mpr; read -r _ mpr _ <<< "$(gh_pr_state "$key" 2>/dev/null)"
    [ -n "$mpr" ] && [ "$mpr" != "none" ] && mpr="https://github.com/${PIPE_REPO_SLUG:-mozilla/fxa}/pull/${mpr}" || mpr=""
    jira_comment "$key" "$(telemetry_merge_comment "$key" "$mpr")" || echo "WARN: merge comment failed for $key" >&2
    # The comment says what landed; this hands the ticket to the reviewer who
    # approved it and closes it. Without this the ticket keeps the status and
    # assignee it had before the pipeline ever saw it.
    jira_close_merged "$key"
  fi
}

# _jira_launch_failed <KEY> <name>
#   A launch that dies before the agent starts (stockout in every zone, image
#   missing, tunnel refused) left the ticket at inflight with no runner, and only
#   a human noticed. Return it to the queue; the next pass tries again and the
#   daily launch budget bounds how often.
_jira_launch_failed() {
  local key="$1" name="$2"
  [ -n "${PIPE_NAME:-}" ] || return 0
  jira_inflight_keys 2>/dev/null | grep -qx "$key" || return 0
  echo "ERROR: launch failed before the agent started; returning ${key} to the queue." >&2
  rm -f "${LOG_DIR}/${name}.meta"
  cmd_label "$key" public >&2 || true
}

# cmd_launch <KEY> <SLOT> [CONTEXT-FILE]
#   WRITE: start an agent VM in the background. The launcher pushes, opens the
#   PR, approves the functional gate, then polls CI, so a pass must not block
#   on it.
cmd_launch() {
  local key="${1:-}" slot="${2:-}" ctx="${3:-}"
  if [ -z "$key" ] || [ -z "$slot" ]; then
    echo "ERROR: launch needs <KEY> <slot> [context-file]" >&2
    return 1
  fi
  if [ -n "$ctx" ] && [ ! -f "$ctx" ]; then
    echo "ERROR: context file '$ctx' not found" >&2
    return 1
  fi
  # A UI change with a sibling *.stories.tsx should ask for /fxa-storybook-capture,
  # and the grounding pass forgets (FXA-14503 shipped a copy change with no
  # screenshot). Warn, do not refuse: the pass may have judged the change
  # non-visual, and a warning it can read beats a launch it cannot make.
  if [ -n "$ctx" ] && ! grep -q 'fxa-storybook-capture' "$ctx"; then
    # `|| true`: a context with no source paths makes grep exit 1, and under
    # pipefail + set -e that aborted the launch with no message (2026-09-17).
    local dirs; dirs="$(grep -oE '(packages|libs)/[A-Za-z0-9_./-]+\.(tsx|ts|jsx|js|ftl|css|scss)' "$ctx" \
      | xargs -n1 dirname 2>/dev/null | sort -u || true)"
    local d hits=""
    for d in $dirs; do
      git -C "$PIPE_REPO" ls-tree -r --name-only origin/main -- "$d" 2>/dev/null | grep -q '\.stories\.tsx$' \
        && hits="${hits}${hits:+ }${d}"
    done
    [ -n "$hits" ] && echo "WARN: ${key}: context names files beside *.stories.tsx but asks for no /fxa-storybook-capture: ${hits}" >&2
  fi
  # Refuse to launch when the disk is too tight to hold another VM clone. A
  # running agent VM occupies 8 to 13GB, and this host filled to 99% on
  # 2026-08-11, which cost a manual cleanup of 19GB. A refused launch is a small
  # annoyance; a disk that fills mid-run corrupts the clone and can take the
  # host down with it.
  local free_gb; free_gb="$(pipeline_free_gb)"
  if [ -n "$free_gb" ] && [ "$free_gb" -lt "$PIPE_MIN_FREE_GB" ]; then
    echo "ERROR: refusing to launch ${key}: only ${free_gb}GB free, need ${PIPE_MIN_FREE_GB}GB." >&2
    echo "       Free space, or raise FXA_MIN_FREE_GB." >&2
    return 1
  fi
  # Rolling 24 h launch budget. Every launch appends one line here.
  local ledger="${PIPE_STATE_DIR}/launches.log" day_ago=$(( $(date +%s) - 86400 )) n
  # awk exits 2 on a missing file, and under set -e that killed the launch silently.
  n=0; [ -f "$ledger" ] && n="$(awk -v t="$day_ago" '$1 >= t' "$ledger" | wc -l | tr -d ' ')"
  if [ "$n" -ge "${PIPE_MAX_LAUNCHES_PER_DAY:-20}" ]; then
    echo "ERROR: refusing to launch ${key}: ${n} launches in 24 h, budget ${PIPE_MAX_LAUNCHES_PER_DAY:-20} (PIPE_MAX_LAUNCHES_PER_DAY)." >&2
    return 1
  fi
  printf '%s %s %s\n' "$(date +%s)" "$key" "$slot" >> "$ledger"
  local args=(--pipeline "$PIPE_NAME" jira "$key" --create-pr --worktree "$slot")
  [ -n "${FXA_AGENT_RUNTIME:-${PIPE_AGENT_RUNTIME:-}}" ] && args+=(--runtime "${FXA_AGENT_RUNTIME:-$PIPE_AGENT_RUNTIME}")
  [ -n "$ctx" ] && args+=(--guardrails "$ctx")
  local log; log="$(pipeline_launch_log "$key")"
  # Record the run this slot still holds before the launch destroys its evidence:
  # the runner overwrites the slot transcript and, for the same key, the launch
  # log below. Runs used to be recorded only at `done`, so a ticket that never
  # got there before its next round (a red infra check, a relaunch) lost the
  # run for good. On 2026-09-17 that was the first runs of FXA-14377 and
  # FXA-14380. telemetry_record is idempotent, so a run `done` already wrote is
  # a no-op here.
  local prev_dir prev_key
  prev_dir="$(dirname "$(worktree_repo_root 2>/dev/null || echo /)")/${slot}"
  prev_key="$(worktree_key_for "$(git -C "$prev_dir" rev-parse --abbrev-ref HEAD 2>/dev/null || true)")"
  if [ -n "$prev_key" ] && [ "$prev_key" != "HEAD" ] && [ -f "$(pipeline_launch_log "$prev_key")" ]; then
    telemetry_record "$prev_key" >/dev/null 2>&1 || true
  fi
  # The same key relaunching on a different slot is the other way to lose a run:
  # the rm below destroys its launch log while its transcript sits in another
  # slot. On 2026-09-18 FXA-14578's fix run went that way when its feedback
  # round landed on fxa-auto-5 before reconcile had labelled it done.
  [ -f "$log" ] && { telemetry_record "$key" >/dev/null 2>&1 || true; }
  # Delete, do not just truncate. `>` reuses the inode and APFS keeps the
  # original st_birthtime, so a relaunched ticket would report a wall time that
  # spans every earlier attempt. telemetry_record reads that birth time.
  rm -f "$log"
  nohup "$0" "${args[@]}" >"$log" 2>&1 &
  # A launched ticket is no longer skipped. Drop the fingerprint, or a later
  # admission skip on this same key would be silenced by a stale match.
  pipeline_skip_clear "$key"
  echo "$key launched on $slot (log ${log})"
}

# ── Main dispatch ──────────────────────────────────────────────

main() {
  # Global flag, before the command: pick which pipeline config the ticket
  # commands read. Defaults to fxa-ai-fixme.
  # --backend picks the VM backend (tart or gce) the same way.
  while :; do
    case "${1:-}" in
      --pipeline) FXA_PIPELINE="${2:?--pipeline needs a name}"; shift 2 ;;
      --backend)  FXA_VM_BACKEND="${2:?--backend needs tart or gce}"; shift 2 ;;
      *) break ;;
    esac
  done
  pipeline_load "$FXA_PIPELINE" || return 1
  vm_backend_load || return 1

  local command="${1:-help}"
  shift 2>/dev/null || true

  case "$command" in
    jira)       cmd_jira "$@" ;;
    finish)     cmd_finish "$@" ;;
    tail)       cmd_tail "$@" ;;
    run)        cmd_run "$@" ;;
    switch)     cmd_switch "$@" ;;
    attach)     cmd_attach "$@" ;;
    services)   cmd_services "$@" ;;
    browser)    cmd_browser "$@" ;;
    test)       cmd_test "$@" ;;
    ssh)        cmd_ssh "$@" ;;
    list|ls)    cmd_list "$@" ;;
    logs|log)   cmd_logs "$@" ;;
    stop)       cmd_stop "$@" ;;
    image)      cmd_image "$@" ;;
    secrets)    cmd_secrets "$@" ;;
    status)     cmd_status "$@" ;;
    reap)       cmd_reap "$@" ;;

    # Ticket-to-PR pipeline (see pipelines/*.conf)
    queue)      cmd_queue "$@" ;;
    inflight)   cmd_inflight "$@" ;;
    reconcile)  cmd_reconcile ;;
    precheck)   cmd_precheck ;;
    done-keys)  cmd_done_keys "$@" ;;
    drain)      cmd_drain "$@" ;;
    label)      cmd_label "$@" ;;
    ticket)     cmd_ticket "$@" ;;
    ground)     cmd_ground "$@" ;;
    reporter)   cmd_reporter "$@" ;;
    slots)      cmd_slots "$@" ;;
    freeslots)  cmd_freeslots "$@" ;;
    launchcap)  cmd_launchcap "$@" ;;
    launch)     cmd_launch "$@" ;;
    alive)      cmd_alive "$@" ;;
    progress)   cmd_progress "$@" ;;
    prstate)    cmd_prstate "$@" ;;
    conflicts)  cmd_conflicts "$@" ;;
    feedback)   cmd_feedback "$@" ;;
    tokens)     cmd_usage_tokens "$@" ;;
    record)     cmd_record "$@" ;;
    costs)      cmd_costs "$@" ;;
    skip)       cmd_skip "$@" ;;
    skipped)    cmd_skipped "$@" ;;
    skip-changed) cmd_skip_changed "$@" ;;
    attempts)   cmd_attempts "$@" ;;
    lock)       cmd_lock "$@" ;;
    snapshot)   cmd_snapshot "$@" ;;
    dashboard)  cmd_dashboard "$@" ;;
    unlock)     cmd_unlock "$@" ;;
    pause)      cmd_pause "$@" ;;
    resume)     cmd_resume ;;
    paused)     cmd_paused ;;
    help|--help|-h)
      usage
      ;;
    *)
      echo "ERROR: Unknown command: ${command}" >&2
      echo "Run 'fxa-sandbox-ctl help' for usage." >&2
      exit 1
      ;;
  esac
}

main "$@"
