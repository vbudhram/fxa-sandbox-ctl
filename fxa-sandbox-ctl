cmd_secrets() {
  local target="${1:-}"
  if [ -z "$target" ]; then
    echo "Usage: fxa-sandbox-ctl secrets <worktree-name-or-path>" >&2
    echo "  e.g. fxa-sandbox-ctl secrets fxa-auto" >&2
    echo "       fxa-sandbox-ctl secrets fxa-auto-2" >&2
    echo "       fxa-sandbox-ctl secrets /Users/me/Desktop/working2/fxa-auto" >&2
    return 1
  fi

  # Accept either an absolute path or a worktree name relative to the FxA repo's parent.
  local path
  if [ -d "$target" ]; then
    path="$target"
  else
    local root parent
    root="$(worktree_repo_root)" || return 1
    parent="$(dirname "$root")"
    path="${parent}/${target}"
    if [ ! -d "$path" ]; then
      echo "ERROR: no worktree at '${path}'." >&2
      return 1
    fi
  fi

  echo "Syncing secrets into ${path}..."
  worktree_copy_secrets "$path"
}

